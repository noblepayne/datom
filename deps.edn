{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        datalevin/datalevin {:mvn/version "0.10.18"}
        http-kit/http-kit {:mvn/version "2.8.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        com.noblepayne/mcp-toolkit {:git/url "https://github.com/noblepayne/mcp-toolkit" :git/sha "fb6c65a2ebb384233b7cd37b050db2a278e9a385"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :jvm-opts ["-Xmx256m" "-XX:+UseSerialGC"]}
           :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
                  :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}
           :mcp {:main-opts ["-m" "datom.mcp"]}
           :api {:main-opts ["-m" "datom.api"]}}}
